diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/get_rows_quant_same.comp b/ggml/src/ggml-vulkan/vulkan-shaders/get_rows_quant_same.comp
new file mode 100644
index 0000000..33aa825
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/get_rows_quant_same.comp
@@ -0,0 +1,39 @@
+#version 450
+
+#include "types.glsl"
+#include "generic_binary_head.glsl"
+
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+#if !defined(BLOCK_BYTES)
+#error BLOCK_BYTES must be defined
+#endif
+
+void main() {
+    const uint i00b = gl_GlobalInvocationID.x;
+    if (i00b >= p.ne00 / QUANT_K) {
+        return;
+    }
+
+    uint gid_z = gl_GlobalInvocationID.z;
+    while (gid_z < p.ne11 * p.ne12) {
+        uint gid_y = gl_GlobalInvocationID.y;
+        while (gid_y < p.ne10) {
+            const uint i10 = gid_y;
+            const uint i11 = gid_z / p.ne12;
+            const uint i12 = gid_z % p.ne12;
+
+            const uint i01 = data_b[i10*p.nb10 + i11*p.nb11 + i12*p.nb12];
+
+            const uint a_block = i01*p.nb01 + i11*p.nb02 + i12*p.nb03 + i00b*p.nb00;
+            const uint d_block = i10*p.nb21 + i11*p.nb22 + i12*p.nb23 + i00b*p.nb20;
+
+            [[unroll]] for (uint j = 0; j < BLOCK_BYTES; ++j) {
+                data_d[d_block*BLOCK_BYTES + j] = data_a[a_block*BLOCK_BYTES + j];
+            }
+
+            gid_y += gl_WorkGroupSize.y * gl_NumWorkGroups.y;
+        }
+        gid_z += gl_WorkGroupSize.z * gl_NumWorkGroups.z;
+    }
+}
